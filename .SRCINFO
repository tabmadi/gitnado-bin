pkgbase = gitnado-bin
	pkgdesc = Fast, privacy-first Git GUI client built with Tauri, Lit and Rust
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/hegsie/gitnado
	arch = x86_64
	license = MIT
	depends = webkit2gtk-4.1
	depends = git
	depends = ca-certificates
	depends = hicolor-icon-theme
	optdepends = openssh: clone and authenticate over SSH, and manage keys from the app
	optdepends = gnupg: sign and verify commits and tags
	optdepends = xdg-utils: open files, folders and links with the default applications
	optdepends = which: detect the configured external diff and merge tools
	optdepends = libayatana-appindicator: system tray icon
	optdepends = xdg-desktop-portal-gtk: follow the desktop light/dark theme
	optdepends = pciutils: GPU detection to recommend a local AI model
	optdepends = nvidia-utils: VRAM detection (nvidia-smi) for local AI on NVIDIA GPUs
	provides = gitnado=1.0.0
	provides = leviathan
	conflicts = gitnado
	conflicts = leviathan
	conflicts = leviathan-bin
	noextract = Gitnado_1.0.0_amd64.deb
	options = !strip
	options = !debug
	source = https://github.com/hegsie/gitnado/releases/download/v1.0.0/Gitnado_1.0.0_amd64.deb
	source = LICENSE-1.0.0::https://raw.githubusercontent.com/hegsie/gitnado/v1.0.0/LICENSE
	sha256sums = 6aa637941d08ec09e550c76d8981440044f37908cf9b27a44c61cd5d719510b2
	sha256sums = a363ba4cc1a17c9a5c3a6206d866769447f6dd9ea996910e400262b981fb2163

pkgname = gitnado-bin
